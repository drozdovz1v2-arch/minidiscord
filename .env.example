# Gmail для MiniDiscord (файл .env на ПК-хосте)
#
# Куда положить .env:
# 1) c:\Users\drozd\OneDrive\Desktop\wq\.env  — разработка
# 2) %APPDATA%\MiniDiscord\.env              — установленное приложение
# 3) рядом с MiniDiscord.exe                  — portable
#
# Gmail: нужен ПАРОЛЬ ПРИЛОЖЕНИЯ (16 символов), не обычный пароль!
# https://myaccount.google.com/apppasswords
#
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=твой@gmail.com
MAIL_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM=MiniDiscord <твой@gmail.com>
REQUIRE_EMAIL_VERIFICATION=true
MAIL_DEV_SHOW_CODE=false
PUBLIC_BASE_URL=http://YOUR_RADMIN_IP:3000
