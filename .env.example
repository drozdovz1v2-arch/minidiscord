# === Почта (только на ПК-хосте, файл .env в корне wq) ===
#
# Если SMTP не настроен — код покажется прямо в приложении.
# Чтобы отключить подтверждение почты для друзей в Radmin:
# REQUIRE_EMAIL_VERIFICATION=false
#
# --- Mail.ru / BK.ru (@mail.ru, @bk.ru, @inbox.ru) ---
# MAIL_HOST=smtp.mail.ru
# MAIL_PORT=465
# MAIL_SECURE=true
# MAIL_USER=твоя_почта@bk.ru
# MAIL_PASS=пароль_от_почты
# MAIL_FROM=твоя_почта@bk.ru
#
# --- Gmail ---
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=твой@gmail.com
# MAIL_PASS=пароль_приложения_16_символов
# MAIL_FROM=твой@gmail.com
#
REQUIRE_EMAIL_VERIFICATION=true
MAIL_DEV_SHOW_CODE=true
PUBLIC_BASE_URL=http://YOUR_RADMIN_IP:3000
